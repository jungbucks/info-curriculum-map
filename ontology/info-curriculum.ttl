@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ic:   <https://jungbucks.github.io/info-curriculum-map/onto#> .
@base         <https://jungbucks.github.io/info-curriculum-map/onto#> .

ic: a owl:Ontology ;
  rdfs:label "정보과 교육과정 온톨로지"@ko ;
  rdfs:comment "2022 개정 정보과 계열(초 실과→중→고→진로·융합) 교육과정의 개념·관계·계열 온톨로지. 자동 생성(build-owl.mjs)."@ko .

# ── 클래스 ──
ic:Subject            a owl:Class ; rdfs:label "과목"@ko .
ic:SchoolLevel        a owl:Class ; rdfs:label "학교급"@ko .
ic:Area               a owl:Class ; rdfs:label "영역"@ko .
ic:AchievementStandard a owl:Class ; rdfs:label "성취기준"@ko .
ic:CoreIdea           a owl:Class ; rdfs:label "핵심 아이디어"@ko .
ic:ContentElement     a owl:Class ; rdfs:label "내용 요소"@ko .
ic:KnowledgeElement   a owl:Class ; rdfs:subClassOf ic:ContentElement ; rdfs:label "지식·이해"@ko .
ic:ProcessElement     a owl:Class ; rdfs:subClassOf ic:ContentElement ; rdfs:label "과정·기능"@ko .
ic:ValueElement       a owl:Class ; rdfs:subClassOf ic:ContentElement ; rdfs:label "가치·태도"@ko .
ic:Concept            a owl:Class ; rdfs:label "핵심 개념(계열)"@ko .
ic:StrandNode         a owl:Class ; rdfs:label "계열 노드(개념×학교급)"@ko .

[] a owl:AllDisjointClasses ; owl:members ( ic:KnowledgeElement ic:ProcessElement ic:ValueElement ) .
[] a owl:AllDisjointClasses ; owl:members ( ic:Subject ic:SchoolLevel ic:Area ic:AchievementStandard ic:CoreIdea ic:ContentElement ic:Concept ) .

# ── 객체 속성 ──
ic:hasArea         a owl:ObjectProperty ; rdfs:domain ic:Subject ; rdfs:range ic:Area ; rdfs:label "영역 보유"@ko .
ic:areaOf          a owl:ObjectProperty ; owl:inverseOf ic:hasArea ; rdfs:label "소속 과목"@ko .
ic:inArea          a owl:ObjectProperty ; rdfs:range ic:Area ; rdfs:label "소속 영역"@ko .
ic:hasStandard     a owl:ObjectProperty ; rdfs:domain ic:Area ; rdfs:range ic:AchievementStandard ; rdfs:label "성취기준 보유"@ko .
ic:hasContentElement a owl:ObjectProperty ; rdfs:domain ic:Area ; rdfs:range ic:ContentElement ; rdfs:label "내용요소 보유"@ko .
ic:hasCoreIdea     a owl:ObjectProperty ; rdfs:domain ic:Area ; rdfs:range ic:CoreIdea ; rdfs:label "핵심아이디어 보유"@ko .
ic:atSchoolLevel   a owl:ObjectProperty ; rdfs:range ic:SchoolLevel ; rdfs:label "학교급"@ko .
ic:belongsToStrand a owl:ObjectProperty ; rdfs:range ic:Concept ; rdfs:label "계열 소속"@ko .
ic:coversArea      a owl:ObjectProperty ; rdfs:domain ic:StrandNode ; rdfs:range ic:Area ; rdfs:label "포함 영역"@ko .
ic:precedes        a owl:ObjectProperty, owl:TransitiveProperty ; rdfs:label "선행(계열)"@ko ;
  rdfs:comment "학습 위계상 앞섬. 하위 속성(위계·확장·전이)의 상위. 이행적(transitive) → 계열 사슬 추론."@ko .
ic:prerequisiteOf  a owl:ObjectProperty ; rdfs:subPropertyOf ic:precedes ; rdfs:label "위계"@ko .
ic:extendedBy      a owl:ObjectProperty ; rdfs:subPropertyOf ic:precedes ; rdfs:label "확장"@ko .
ic:transitionsTo   a owl:ObjectProperty ; rdfs:subPropertyOf ic:precedes ; rdfs:label "전이"@ko .

# ── 데이터 속성 ──
ic:code           a owl:DatatypeProperty ; rdfs:domain ic:AchievementStandard ; rdfs:range xsd:string ; rdfs:label "성취기준 코드"@ko .
ic:hasText        a owl:DatatypeProperty ; rdfs:range xsd:string ; rdfs:label "본문"@ko .
ic:levelNo        a owl:DatatypeProperty ; rdfs:range xsd:integer ; rdfs:label "학교급 단계(1~4)"@ko .
ic:areaNo         a owl:DatatypeProperty ; rdfs:domain ic:Area ; rdfs:range xsd:integer ; rdfs:label "영역 번호"@ko .
ic:sequenceNo     a owl:DatatypeProperty ; rdfs:range xsd:integer ; rdfs:label "순번"@ko .
ic:cognitiveDepth a owl:DatatypeProperty ; rdfs:domain ic:ProcessElement ; rdfs:range xsd:integer ;
  rdfs:label "심화(깊이 1~6)"@ko ; rdfs:comment "과정·기능 서술어 자동 사전(depth.json) 기반. 1 기억~6 창안."@ko .

# ── 공리(제약) ──
ic:AchievementStandard rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ic:inArea ; owl:someValuesFrom ic:Area ] .
ic:AchievementStandard rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ic:atSchoolLevel ; owl:someValuesFrom ic:SchoolLevel ] .
ic:Area rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ic:areaOf ; owl:someValuesFrom ic:Subject ] .

# ══════════ 인스턴스(ABox) ══════════

# 학교급
ic:Level1 a ic:SchoolLevel ; ic:levelNo 1 ; rdfs:label "초등 실과"@ko .
ic:Level2 a ic:SchoolLevel ; ic:levelNo 2 ; rdfs:label "중학교 정보"@ko .
ic:Level3 a ic:SchoolLevel ; ic:levelNo 3 ; rdfs:label "고등 정보"@ko .
ic:Level4 a ic:SchoolLevel ; ic:levelNo 4 ; rdfs:label "진로·융합선택"@ko .

# 핵심 개념(계열)
ic:CONCEPT_컴퓨팅_시스템 a ic:Concept ; rdfs:label "컴퓨팅 시스템"@ko .
ic:CONCEPT_데이터 a ic:Concept ; rdfs:label "데이터"@ko .
ic:CONCEPT_알고리즘과_프로그래밍 a ic:Concept ; rdfs:label "알고리즘과 프로그래밍"@ko .
ic:CONCEPT_인공지능 a ic:Concept ; rdfs:label "인공지능"@ko .
ic:CONCEPT_디지털_문화 a ic:Concept ; rdfs:label "디지털 문화"@ko .

# 과목
ic:SUBJ_초등_실과정보 a ic:Subject ; rdfs:label "초등 실과(정보)"@ko ; ic:atSchoolLevel ic:Level1 .
ic:SUBJ_중학교_정보 a ic:Subject ; rdfs:label "중학교 정보"@ko ; ic:atSchoolLevel ic:Level2 .
ic:SUBJ_고등_정보 a ic:Subject ; rdfs:label "고등 정보"@ko ; ic:atSchoolLevel ic:Level3 .
ic:SUBJ_인공지능_기초 a ic:Subject ; rdfs:label "인공지능 기초"@ko ; ic:atSchoolLevel ic:Level4 .
ic:SUBJ_데이터_과학 a ic:Subject ; rdfs:label "데이터 과학"@ko ; ic:atSchoolLevel ic:Level4 .
ic:SUBJ_소프트웨어와_생활 a ic:Subject ; rdfs:label "소프트웨어와 생활"@ko ; ic:atSchoolLevel ic:Level4 .

# 영역 · 핵심아이디어 · 내용요소
ic:AREA_초등_실과정보_5 a ic:Area ; rdfs:label "디지털 사회와 인공지능"@ko ; ic:areaNo 5 ; ic:areaOf ic:SUBJ_초등_실과정보 ; ic:atSchoolLevel ic:Level1 ; ic:belongsToStrand ic:CONCEPT_컴퓨팅_시스템, ic:CONCEPT_데이터, ic:CONCEPT_알고리즘과_프로그래밍, ic:CONCEPT_인공지능, ic:CONCEPT_디지털_문화 .
ic:CI_초등_실과정보_5_1 a ic:CoreIdea ; rdfs:label "프로그래밍은 디지털 사회에서 발생하는 다양한 문제를 해결하는 데 도움을 준다."@ko ; ic:hasText "프로그래밍은 디지털 사회에서 발생하는 다양한 문제를 해결하는 데 도움을 준다."@ko .
ic:AREA_초등_실과정보_5 ic:hasCoreIdea ic:CI_초등_실과정보_5_1 .
ic:CI_초등_실과정보_5_2 a ic:CoreIdea ; rdfs:label "컴퓨터로 처리할 수 있는 데이터는 디지털 데이터이며, 문제 해결을 위한 명령은 명확한 절차가 필요하다."@ko ; ic:hasText "컴퓨터로 처리할 수 있는 데이터는 디지털 데이터이며, 문제 해결을 위한 명령은 명확한 절차가 필요하다."@ko .
ic:AREA_초등_실과정보_5 ic:hasCoreIdea ic:CI_초등_실과정보_5_2 .
ic:CI_초등_실과정보_5_3 a ic:CoreIdea ; rdfs:label "인공지능은 인간의 지능을 모방하여 만든 프로그램 시스템으로 생활 속의 다양한 분야에 영향을 미친다."@ko ; ic:hasText "인공지능은 인간의 지능을 모방하여 만든 프로그램 시스템으로 생활 속의 다양한 분야에 영향을 미친다."@ko .
ic:AREA_초등_실과정보_5 ic:hasCoreIdea ic:CI_초등_실과정보_5_3 .
ic:EL_초등_실과정보_5_K1 a ic:KnowledgeElement ; rdfs:label "컴퓨터의 개념"@ko ; ic:hasText "컴퓨터의 개념"@ko .
ic:AREA_초등_실과정보_5 ic:hasContentElement ic:EL_초등_실과정보_5_K1 .
ic:EL_초등_실과정보_5_K2 a ic:KnowledgeElement ; rdfs:label "문제 찾기와 문제 해결 절차"@ko ; ic:hasText "문제 찾기와 문제 해결 절차"@ko .
ic:AREA_초등_실과정보_5 ic:hasContentElement ic:EL_초등_실과정보_5_K2 .
ic:EL_초등_실과정보_5_K3 a ic:KnowledgeElement ; rdfs:label "컴퓨터에게 명령하는 방법"@ko ; ic:hasText "컴퓨터에게 명령하는 방법"@ko .
ic:AREA_초등_실과정보_5 ic:hasContentElement ic:EL_초등_실과정보_5_K3 .
ic:EL_초등_실과정보_5_K4 a ic:KnowledgeElement ; rdfs:label "데이터의 종류와 표현"@ko ; ic:hasText "데이터의 종류와 표현"@ko .
ic:AREA_초등_실과정보_5 ic:hasContentElement ic:EL_초등_실과정보_5_K4 .
ic:EL_초등_실과정보_5_K5 a ic:KnowledgeElement ; rdfs:label "생활 속 인공지능"@ko ; ic:hasText "생활 속 인공지능"@ko .
ic:AREA_초등_실과정보_5 ic:hasContentElement ic:EL_초등_실과정보_5_K5 .
ic:EL_초등_실과정보_5_P1 a ic:ProcessElement ; rdfs:label "생활 속에서 활용되는 컴퓨터의 사례 탐색하기"@ko ; ic:hasText "생활 속에서 활용되는 컴퓨터의 사례 탐색하기"@ko ; ic:cognitiveDepth 2 .
ic:AREA_초등_실과정보_5 ic:hasContentElement ic:EL_초등_실과정보_5_P1 .
ic:EL_초등_실과정보_5_P2 a ic:ProcessElement ; rdfs:label "일상생활의 문제를 해결하기 위한 알고리즘 구상하기"@ko ; ic:hasText "일상생활의 문제를 해결하기 위한 알고리즘 구상하기"@ko ; ic:cognitiveDepth 6 .
ic:AREA_초등_실과정보_5 ic:hasContentElement ic:EL_초등_실과정보_5_P2 .
ic:EL_초등_실과정보_5_P3 a ic:ProcessElement ; rdfs:label "문제를 해결하는 기초적인 프로그래밍하기"@ko ; ic:hasText "문제를 해결하는 기초적인 프로그래밍하기"@ko ; ic:cognitiveDepth 3 .
ic:AREA_초등_실과정보_5 ic:hasContentElement ic:EL_초등_실과정보_5_P3 .
ic:EL_초등_실과정보_5_P4 a ic:ProcessElement ; rdfs:label "데이터 간에 공통되는 유형이나 형태 탐색하기"@ko ; ic:hasText "데이터 간에 공통되는 유형이나 형태 탐색하기"@ko ; ic:cognitiveDepth 2 .
ic:AREA_초등_실과정보_5 ic:hasContentElement ic:EL_초등_실과정보_5_P4 .
ic:EL_초등_실과정보_5_P5 a ic:ProcessElement ; rdfs:label "인공지능이 만들어지는 과정 탐색하기"@ko ; ic:hasText "인공지능이 만들어지는 과정 탐색하기"@ko ; ic:cognitiveDepth 2 .
ic:AREA_초등_실과정보_5 ic:hasContentElement ic:EL_초등_실과정보_5_P5 .
ic:EL_초등_실과정보_5_V1 a ic:ValueElement ; rdfs:label "생활 속에서 컴퓨터를 활용해 해결 가능한 문제를 탐색해 보려는 자세"@ko ; ic:hasText "생활 속에서 컴퓨터를 활용해 해결 가능한 문제를 탐색해 보려는 자세"@ko .
ic:AREA_초등_실과정보_5 ic:hasContentElement ic:EL_초등_실과정보_5_V1 .
ic:EL_초등_실과정보_5_V2 a ic:ValueElement ; rdfs:label "프로그래밍을 통해 만든 산출물을 타인과 공유하고 협력하려는 자세"@ko ; ic:hasText "프로그래밍을 통해 만든 산출물을 타인과 공유하고 협력하려는 자세"@ko .
ic:AREA_초등_실과정보_5 ic:hasContentElement ic:EL_초등_실과정보_5_V2 .
ic:EL_초등_실과정보_5_V3 a ic:ValueElement ; rdfs:label "생활 속의 여러 가지 데이터가 갖는 의미를 파악하는 자세"@ko ; ic:hasText "생활 속의 여러 가지 데이터가 갖는 의미를 파악하는 자세"@ko .
ic:AREA_초등_실과정보_5 ic:hasContentElement ic:EL_초등_실과정보_5_V3 .
ic:EL_초등_실과정보_5_V4 a ic:ValueElement ; rdfs:label "인공지능이 사회에 미치는 영향을 파악하는 자세"@ko ; ic:hasText "인공지능이 사회에 미치는 영향을 파악하는 자세"@ko .
ic:AREA_초등_실과정보_5 ic:hasContentElement ic:EL_초등_실과정보_5_V4 .
ic:AREA_중학교_정보_1 a ic:Area ; rdfs:label "컴퓨팅 시스템"@ko ; ic:areaNo 1 ; ic:areaOf ic:SUBJ_중학교_정보 ; ic:atSchoolLevel ic:Level2 ; ic:belongsToStrand ic:CONCEPT_컴퓨팅_시스템 .
ic:CI_중학교_정보_1_1 a ic:CoreIdea ; rdfs:label "하드웨어와 소프트웨어의 유기적 연결을 통해 동작하는 컴퓨팅 시스템은 사회적, 기술적 가치를 높이는 데 활용된다."@ko ; ic:hasText "하드웨어와 소프트웨어의 유기적 연결을 통해 동작하는 컴퓨팅 시스템은 사회적, 기술적 가치를 높이는 데 활용된다."@ko .
ic:AREA_중학교_정보_1 ic:hasCoreIdea ic:CI_중학교_정보_1_1 .
ic:CI_중학교_정보_1_2 a ic:CoreIdea ; rdfs:label "컴퓨팅 시스템을 설계하는 것은 시스템에 대한 전체 흐름과 자원 할당의 가치를 이해하는 데 도움을 준다."@ko ; ic:hasText "컴퓨팅 시스템을 설계하는 것은 시스템에 대한 전체 흐름과 자원 할당의 가치를 이해하는 데 도움을 준다."@ko .
ic:AREA_중학교_정보_1 ic:hasCoreIdea ic:CI_중학교_정보_1_2 .
ic:EL_중학교_정보_1_K1 a ic:KnowledgeElement ; rdfs:label "컴퓨팅 시스템의 동작 원리"@ko ; ic:hasText "컴퓨팅 시스템의 동작 원리"@ko .
ic:AREA_중학교_정보_1 ic:hasContentElement ic:EL_중학교_정보_1_K1 .
ic:EL_중학교_정보_1_K2 a ic:KnowledgeElement ; rdfs:label "운영 체제의 기능"@ko ; ic:hasText "운영 체제의 기능"@ko .
ic:AREA_중학교_정보_1 ic:hasContentElement ic:EL_중학교_정보_1_K2 .
ic:EL_중학교_정보_1_K3 a ic:KnowledgeElement ; rdfs:label "피지컬 컴퓨팅의 개념"@ko ; ic:hasText "피지컬 컴퓨팅의 개념"@ko .
ic:AREA_중학교_정보_1 ic:hasContentElement ic:EL_중학교_정보_1_K3 .
ic:EL_중학교_정보_1_P1 a ic:ProcessElement ; rdfs:label "컴퓨팅 시스템의 구성요소를 파악하고, 동작 원리를 운영 체제와 관계짓기"@ko ; ic:hasText "컴퓨팅 시스템의 구성요소를 파악하고, 동작 원리를 운영 체제와 관계짓기"@ko .
ic:AREA_중학교_정보_1 ic:hasContentElement ic:EL_중학교_정보_1_P1 .
ic:EL_중학교_정보_1_P2 a ic:ProcessElement ; rdfs:label "생활 속에서 피지컬 컴퓨팅이 적용된 사례 조사하기"@ko ; ic:hasText "생활 속에서 피지컬 컴퓨팅이 적용된 사례 조사하기"@ko ; ic:cognitiveDepth 2 .
ic:AREA_중학교_정보_1 ic:hasContentElement ic:EL_중학교_정보_1_P2 .
